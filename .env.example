PORT=3000
NODE_ENV=production

# Session & Auth (change these for production!)
SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_USER=admin
ADMIN_PASS=admin

# Database (defaults to SQLite at ./data/uptime.sqlite)
DB_DRIVER=sqlite
SQLITE_PATH=./data/uptime.sqlite

# Optional Ookla Speedtest CLI override path
# SPEEDTEST_PATH=
